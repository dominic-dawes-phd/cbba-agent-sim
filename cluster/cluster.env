# Cluster settings: the only file to edit (docs/design/cluster.md). Sourced by the cluster scripts.
# Ask your cluster's docs or `sinfo -s` for the partition and GPU names.

# Slurm partition with GPU nodes, and the account to charge (leave ACCOUNT empty if none).
PARTITION=gpu
ACCOUNT=
# --gres value per array task: one GPU (name a type if needed, e.g. gpu:a100:1).
GPU_REQUEST=gpu:1
CPUS=8
MEM=32G
# Wall-clock limit per array task. One house episode took about 70 min on the laptop GPU.
TIME=24:00:00
# Anything else your cluster needs, e.g. "--qos=normal" (left unquoted on purpose: split on spaces).
EXTRA_SBATCH=

# Large files (the image, models, the apptainer cache) go on scratch, not under a $HOME quota.
SCRATCH_DIR=$HOME/scratch/cbba
# The runtime image built by .github/workflows/container.yml (tag = llama.cpp build).
IMAGE=docker://ghcr.io/dominic-dawes-phd/cbba-agent-sim:b12211
