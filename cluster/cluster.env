# Cluster settings: the only file to edit (docs/design/cluster.md). Sourced by the cluster scripts.
# Defaults are for UMBC HPCF "chip" (https://hpcf.umbc.edu); setup.sh writes cluster_info.txt to
# check them against what your account can use.

# Your PI group: the part after "pi_" (e.g. pi_doit -> doit). Your account request names it.
GROUP=CHANGEME
ACCOUNT=pi_$GROUP
# chip's GPUs are their own Slurm cluster; every Slurm command needs -M chip-gpu.
CLUSTER=chip-gpu
# "gpu" is the default GPU partition; "gpu-general" avoids contributor preemption if it has the GPUs.
PARTITION=gpu
# --gres per array task (chip always uses gpu:N) and the GPU model (--constraint). One experiment
# uses one GPU model, because replies can differ between GPU models (docs/design/decisions.md).
GPU_REQUEST=gpu:1
GPU_CONSTRAINT=L40S
CPUS=8
MEM=32G
# Wall-clock limit per array task: 3 house episodes per shard; chip may preempt jobs after 3 days.
TIME=12:00:00
# Apptainer comes from a module on chip's compute nodes (never "module load shared" on a GPU node).
APPTAINER_MODULE=apptainer
# Optional: an email address for one message when a launch is finished and packed (leave empty).
MAIL_USER=
# Anything else your cluster needs, e.g. "--qos=normal" (left unquoted on purpose: split on spaces).
EXTRA_SBATCH=

# Large files (the image, models, caches) live on the research volume: home is only 500 MB, and
# chip's /scratch is deleted when each job ends. Clone the repo under the same folder.
DATA_DIR=/umbc/rs/$GROUP/users/${USER:-$(id -un)}/cbba
# The login host, for the scp command that brings results back to the laptop.
LOGIN_HOST=chip.rs.umbc.edu
# The runtime image built by .github/workflows/container.yml (tag = llama.cpp build).
IMAGE=docker://ghcr.io/dominic-dawes-phd/cbba-agent-sim:b12211
